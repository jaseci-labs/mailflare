# A page's primary "New ..." button floats at the bottom of the screen on phones, within thumb reach;
# the second is the same, lifted above the settings section pill.
glob mobilePrimaryActionClass: str = "max-md:fixed max-md:inset-x-4 max-md:bottom-4 max-md:z-40 max-md:h-12 max-md:rounded-full max-md:shadow-lg",
     mobilePrimaryActionAboveNavClass: str = "max-md:fixed max-md:inset-x-4 max-md:bottom-20 max-md:z-40 max-md:h-12 max-md:rounded-full max-md:shadow-lg";
